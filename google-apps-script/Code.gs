  'farm_count', 'repeat_phone',
  // Added later; kept at the end so older sheets stay aligned.
  'state', 'lga_source', 'detected_state', 'detected_lga'
];
var FARM_HEADERS = [
  'registration_id', 'farm_no', 'full_name', 'phone_e164', 'lga', 'town_or_village',
  'lat', 'lng', 'gps_accuracy_m', 'needs_agent_help', 'size_value', 'size_unit',
  'estimated_area_m2', 'estimated_radius_m', 'map_link',
