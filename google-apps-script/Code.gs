var LGA_SOURCES = ['gps', 'changed', 'chosen'];
var CROP_STAGES = ['vegetative', 'flowering', 'fruit_set', 'harvesting'];
var SIZE_UNITS = ['plots', 'acres', 'hectares'];
var MAX_FARMS = 5;
var MAX_ACCURACY_M = 100; // the page never accepts a worse reading

/** Run once from the editor (optional): creates both tabs with headers. */
function setup() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  getSheet_(ss, REG_SHEET, REG_HEADERS);
  getSheet_(ss, FARM_SHEET, FARM_HEADERS);
}

/** Opening the URL in a browser just confirms the deployment is live. */
function doGet() {
  return json_({ ok: true, service: 'GrowLine registrations' });
}

function doPost(e) {
  var data;
  try {
    data = JSON.parse((e && e.postData && e.postData.contents) || '');
  } catch (err) {
    return json_({ ok: false, error: 'bad_json' });
  }

  // Spam trap: the page has a hidden box people never fill. If it has text,
  // a bot sent this. Answer "ok" so it doesn't retry, but save nothing.
  if (data && typeof data.hp === 'string' && data.hp.trim() !== '') {
    console.log('Honeypot caught a submission; not saved.');
    return json_({ ok: true });
  }

  var problem = validate_(data);
  if (problem) return json_({ ok: false, error: problem });

  // One writer at a time, so rows from two farmers never interleave.
  var lock = LockService.getScriptLock();
  try {
    lock.waitLock(20000);
  } catch (err) {
    return json_({ ok: false, error: 'busy' });
  }

  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var regSheet = getSheet_(ss, REG_SHEET, REG_HEADERS);
    var farmSheet = getSheet_(ss, FARM_SHEET, FARM_HEADERS);

    var id = Utilities.getUuid();
    var receivedAt = new Date().toISOString();
    var repeat = phoneSeen_(regSheet, data.phone_e164);

    regSheet.appendRow([
      id, receivedAt, data.submitted_at, text_(data.full_name), text_(data.phone_e164),
      data.lga, text_(data.town_or_village), data.crop_stage, true, !!data.needs_agent_help,
      data.farms.length, repeat ? 'yes' : 'no',
      data.state, data.lga_source, data.detected_state || '', data.detected_lga || ''
    ]);

    var rows = data.farms.map(function (f, i) {
      var hasPoint = typeof f.lat === 'number' && typeof f.lng === 'number';
      return [
        id, i + 1, text_(data.full_name), text_(data.phone_e164), data.lga, text_(data.town_or_village),
        hasPoint ? f.lat : '', hasPoint ? f.lng : '', hasPoint ? f.gps_accuracy_m : '',
        hasPoint ? false : true, f.size_value, f.size_unit,
        f.estimated_area_m2, f.estimated_radius_m,
        hasPoint ? 'https://www.google.com/maps?q=' + f.lat + ',' + f.lng : '',
        isNum_(f.estimated_perimeter_m, 0, 1e7) ? f.estimated_perimeter_m : '',
        f.estimated_footprint ? JSON.stringify(f.estimated_footprint) : '',
        data.state
      ];
    });
    farmSheet.getRange(farmSheet.getLastRow() + 1, 1, rows.length, FARM_HEADERS.length).setValues(rows);

    return json_({ ok: true, registration_id: id });
  } catch (err) {
    console.error(err);
    return json_({ ok: false, error: 'save_failed' });
  } finally {
    lock.releaseLock();
  }
}

/* ---------------- helpers ---------------- */

/** Returns an error code, or '' when the registration is acceptable. */
function validate_(d) {
  if (!d || typeof d !== 'object') return 'bad_payload';
  if (!isText_(d.full_name, 2, 100)) return 'full_name';
  if (typeof d.phone_e164 !== 'string' || !/^\+234(70|80|81|90|91)\d{8}$/.test(d.phone_e164)) return 'phone_e164';
  if (!NG_LGAS.hasOwnProperty(d.state)) return 'state';
  if (NG_LGAS[d.state].indexOf(d.lga) < 0) return 'lga';
  if (LGA_SOURCES.indexOf(d.lga_source) < 0) return 'lga_source';
  if (d.detected_state != null && !NG_LGAS.hasOwnProperty(d.detected_state)) return 'detected_state';
  if (d.detected_lga != null && (d.detected_state == null || NG_LGAS[d.detected_state].indexOf(d.detected_lga) < 0)) return 'detected_lga';
  if (!isText_(d.town_or_village, 2, 100)) return 'town_or_village';
  if (CROP_STAGES.indexOf(d.crop_stage) < 0) return 'crop_stage';
  if (d.consent !== true) return 'consent';
  if (typeof d.submitted_at !== 'string' || isNaN(Date.parse(d.submitted_at))) return 'submitted_at';
  if (!Array.isArray(d.farms) || d.farms.length < 1 || d.farms.length > MAX_FARMS) return 'farms';

  for (var i = 0; i < d.farms.length; i++) {
    var f = d.farms[i];
    if (!f || typeof f !== 'object') return 'farm_' + (i + 1);
    var hasPoint = f.lat !== null && f.lat !== undefined;
    if (hasPoint) {
      if (!isNum_(f.lat, -90, 90) || !isNum_(f.lng, -180, 180)) return 'farm_' + (i + 1) + '_location';
      if (!isNum_(f.gps_accuracy_m, 0, MAX_ACCURACY_M)) return 'farm_' + (i + 1) + '_accuracy';
    } else if (d.needs_agent_help !== true) {
      return 'farm_' + (i + 1) + '_location';  // no point is only allowed with agent help
    }
    if (!isNum_(f.size_value, 0, 100000) || f.size_value <= 0) return 'farm_' + (i + 1) + '_size';
    if (SIZE_UNITS.indexOf(f.size_unit) < 0) return 'farm_' + (i + 1) + '_unit';
    if (!isNum_(f.estimated_area_m2, 0, 1e9) || !isNum_(f.estimated_radius_m, 0, 1e6)) return 'farm_' + (i + 1) + '_footprint';
    if (f.estimated_perimeter_m != null && !isNum_(f.estimated_perimeter_m, 0, 1e7)) return 'farm_' + (i + 1) + '_perimeter';
    if (f.estimated_footprint != null && (!hasPoint || !isRing_(f.estimated_footprint))) return 'farm_' + (i + 1) + '_footprint_points';
  }
  return '';
}

/** A GeoJSON Polygon with one closed ring of 4–65 [lng, lat] points. */
function isRing_(g) {
  if (!g || g.type !== 'Polygon' || !Array.isArray(g.coordinates) || g.coordinates.length !== 1) return false;
  var ring = g.coordinates[0];
  if (!Array.isArray(ring) || ring.length < 4 || ring.length > 65) return false;
  for (var i = 0; i < ring.length; i++) {
    var p = ring[i];
    if (!Array.isArray(p) || p.length !== 2 || !isNum_(p[0], -180, 180) || !isNum_(p[1], -90, 90)) return false;
  }
  var a = ring[0], z = ring[ring.length - 1];
  return a[0] === z[0] && a[1] === z[1];
}

function isText_(v, min, max) {
  return typeof v === 'string' && v.trim().length >= min && v.length <= max;
}

function isNum_(v, min, max) {
  return typeof v === 'number' && isFinite(v) && v >= min && v <= max;
}

/** Stops typed text being read as a formula, and keeps "+234…" as text. */
function text_(v) {
  var s = String(v == null ? '' : v).trim();
  return /^[=+\-@]/.test(s) ? "'" + s : s;
}

function phoneSeen_(sheet, phone) {
  var last = sheet.getLastRow();
  if (last < 2) return false;
  var col = REG_HEADERS.indexOf('phone_e164') + 1;
  var values = sheet.getRange(2, col, last - 1, 1).getDisplayValues();
  for (var i = 0; i < values.length; i++) {
    if (String(values[i][0]).replace(/^'/, '') === phone) return true;
  }
  return false;
}

function getSheet_(ss, name, headers) {
  var sheet = ss.getSheetByName(name);
  if (!sheet) sheet = ss.insertSheet(name);
  if (sheet.getLastRow() === 0) {
    sheet.appendRow(headers);
    sheet.setFrozenRows(1);
    sheet.getRange(1, 1, 1, headers.length).setFontWeight('bold');
  } else if (sheet.getLastColumn() < headers.length) {
    // A sheet made by an older version: add the new column names on the right.
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]).setFontWeight('bold');
  }
  return sheet;
}

function json_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}
